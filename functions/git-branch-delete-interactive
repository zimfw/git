# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local -a gremotes
if (( ${*[(I)(-r|--remotes)]} )); then
  gremotes=(${^*:#-*})
else
  local gbranch
  for gbranch (${@:#-*}) gremotes+=(${(f)"$(command git rev-parse --abbrev-ref ${gbranch}@{u} 2>/dev/null)"})
fi
local -i gerror=0
command git branch --delete ${@} || gerror=1
if (( ${#gremotes} )) && read -q "?Also delete remote branch(es) ${gremotes} [y/N]? "; then
  print
  local gremote
  for gremote (${gremotes}) command git push ${gremote%%/*} :${gremote#*/} || gerror=1
fi
return ${gerror}
