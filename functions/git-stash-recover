# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

if (( ! # )); then
  print -u2 "usage: ${0} <commit...>"
  return 2
fi

local gcommit
local -i gerror=0
for gcommit in "${@}"; do
  command git stash store -m "$(command git log -1 --pretty='format:%s' ${gcommit})" ${gcommit} || gerror=1
done
return ${gerror}
