# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local git_root git_dir
git_root=$(git-root) || return 1
git_dir=$(git-dir) || return 1

if (( # != 1 )); then
  print -u2 "usage: ${0} <path>"
  return 2
fi

if ! command git -C ${git_root} config --file .gitmodules --get submodule.${1}.path &>/dev/null; then
  print -u2 "${0}: submodule not found: ${1}"
  return 1
fi

command git -C ${git_root} rm -q ${1} || return 1
command git -C ${git_root} config --remove-section submodule.${1} 2>/dev/null
command rm -rf ${git_dir}/modules/${1} || return 1
command rmdir -p ${git_dir}/modules/${1:h} 2>/dev/null
return 0
