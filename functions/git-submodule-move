# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local git_root
git_root=$(git-root) || return 1

if (( # != 2 )); then
  print -u2 "usage: ${0} <source> <destination>"
  return 2
fi

local -r gurl=$(command git -C ${git_root} config --file .gitmodules --get submodule.${1}.url)
if [[ -z ${gurl} ]]; then
  print -u2 "${0}: submodule not found: ${1}"
  return 1
fi

git-submodule-remove ${1} && \
    command git -C ${git_root} submodule add ${gurl} ${2}
