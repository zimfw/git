# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local -a grefs gfields
local gref
grefs=(${(f)"$(command git for-each-ref --format '%(refname:lstrip=2) %(upstream:track,nobracket)' refs/heads)"}) || return 1 # lstrip and nobracket require Git 2.13
for gref in ${grefs}; do
  gfields=(${(s: :)gref})
  if [[ ${gfields[2]} == ${1} && ${gfields[4]} == ${2} ]] print -R ${gfields[1]}
done
